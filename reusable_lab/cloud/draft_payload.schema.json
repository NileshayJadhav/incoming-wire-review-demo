{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guarded Office Script draft payload",
  "description": "Only the writer input shape. Schema validation alone does not validate PDF evidence or authorize a conclusion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sheetName", "headerRow", "samples"],
  "properties": {
    "sheetName": {"type": "string", "minLength": 1, "maxLength": 31},
    "headerRow": {"type": "integer", "minimum": 1, "maximum": 100},
    "samples": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["row", "sampleId", "customer", "account", "fee", "feeCharged", "classification", "travel", "ofac", "posting", "comments"],
        "properties": {
          "row": {"type": "integer", "minimum": 2},
          "sampleId": {"type": "string", "minLength": 1},
          "customer": {"type": "string", "minLength": 1},
          "account": {"type": "string", "minLength": 1},
          "fee": {"type": ["number", "null"], "minimum": 0},
          "feeCharged": {"enum": ["X", "-", "OPEN"]},
          "classification": {"enum": ["Domestic", "Foreign", "OPEN"]},
          "travel": {"enum": ["X", "-", "OPEN"]},
          "ofac": {"enum": ["X", "-", "OPEN"]},
          "posting": {"enum": ["X", "-", "OPEN"]},
          "comments": {"type": "string", "pattern": "^DRAFT\\.", "maxLength": 1000}
        }
      }
    }
  }
}
